{
  "manifest_version": 2,
  "name": "Decifra",
  "version": "1.0.0",
  "description": "Extensão de acessibilidade para leitura: ajuste de fonte, contraste, espaçamento, régua de leitura e simplificação visual.",
  "author": "Decifra",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/decifralogo96.png",
      "96": "icons/decifralogo96.png"
    },
    "default_title": "Decifra - Acessibilidade de Leitura"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "icons": {
    "48": "icons/decifralogo96.png",
    "96": "icons/decifralogo96.png"
  }
}
